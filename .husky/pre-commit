#!/bin/sh
# Rapido y barato. La suite completa va en pre-push; la reja real, en CI.
# Ver docs/adr/0001-decisiones-tecnicas-fase-0.md seccion 7.

pnpm biome check --staged --no-errors-on-unmatched || exit 1
pnpm typecheck || exit 1
# Solo el proyecto `unit`. Los de integracion necesitan Postgres y las dos
# URLs de conexion; arrastrarlos aca haria fallar cada commit hecho sin la
# base levantada. Corren en pre-push y, sobre todo, en CI.
pnpm vitest related --run --project unit --passWithNoTests || exit 1

# Revision de IA contra AGENTS.md. Solo lee, no toca el repositorio.
#
# `--pr-mode` fuera de main, y no es aflojar la reja: es darle MAS contexto.
# `gga run` a secas mira solo el diff staged, asi que en una rama de varios
# commits reporta como ausente todo lo que ya se commiteo en la misma rama.
# Paso de verdad en PR 2 de auth-rbac: dijo tres veces que `verificaciones`
# no tenia test de aislamiento, con los cinco `*.isolation.test.ts`
# commiteados y pasando. Y se contradijo entre corridas segun que archivos
# cayeran en el diff.
#
# El modo staged solo es correcto en main, donde el commit anterior ya paso
# por su propia revision. `--pr-mode` compara contra PR_BASE_BRANCH y ve la
# rama entera; con ese contexto encontro cosas que el otro no vio, como la
# FK de una sola columna que dejaba enlazar un usuario de otro municipio.
# Y hay un tercer caso, que aparecio recien cuando empezamos a mergear
# seguido: en una rama sin commits por delante de main, `main...HEAD` esta
# vacio. `--pr-mode` reporta "No matching files changed in PR" y **sale en
# verde sin revisar una linea**, con todo el cambio staged delante. O sea
# que el primer commit de cada rama se colaba sin revision. Paso con
# `feat/bitacora-alta`, y es el mismo defecto que el job de CI tenia por no
# tener la rama base. Ahi el modo staged es el unico que ve algo.
if [ "$(git branch --show-current)" = "main" ]; then
  gga run || exit 1
elif [ "$(git rev-list --count main..HEAD)" -eq 0 ]; then
  gga run || exit 1
else
  gga run --pr-mode || exit 1
fi
