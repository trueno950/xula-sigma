#!/bin/sh
# Limites de capa y suite antes de que salga de la maquina.

pnpm check || exit 1
pnpm vitest run --project unit || exit 1

# Revision de IA en el mismo modo que CI: mismo comando, misma variante del
# modelo (GGA_OPENCODE_VARIANT=high). El pre-commit corre en modo rapido a
# proposito (comodidad, no la reja real, ver ADR 0001 seccion 7) — pero eso
# significa que un hallazgo que solo el modo `high` ve no aparecia hasta
# despues de empujar y esperar a CI. Corrida aca, aparece antes de salir de
# la maquina, sin la vuelta completa de push + Actions + otro push.
#
# Solo en ramas con PR de por medio: en `main` no hay contra que comparar.
if [ "$(git branch --show-current)" != "main" ]; then
  GGA_OPENCODE_VARIANT=high gga run --pr-mode --diff-only || exit 1
fi

# Los tests de aislamiento necesitan Postgres. Se corren si hay base; si no
# la hay, se avisa fuerte y se sigue.
#
# La alternativa —fallar el push— suena mas estricta pero es peor: un hook
# que falla siempre ensena a usar --no-verify, y ahi se pierde el gate
# entero. El gate real es CI, que los corre sin condicion. Ver ADR 0001
# seccion 7.
if [ -n "$DATABASE_URL" ] && [ -n "$MIGRATION_DATABASE_URL" ]; then
  pnpm vitest run --project integration || exit 1
else
  echo ""
  echo "  ⚠  AISLAMIENTO ENTRE MUNICIPIOS: NO VERIFICADO EN ESTA MAQUINA"
  echo ""
  echo "     Sin DATABASE_URL ni MIGRATION_DATABASE_URL no hay base contra"
  echo "     la cual probar RLS. CI los corre igual y bloquea el merge."
  echo ""
  echo "     Para correrlos aca:  pnpm db:local"
  echo ""
fi
