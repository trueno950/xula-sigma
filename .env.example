# DOS roles, no uno. Es lo que hace que RLS sirva de algo.
# Railway entrega un solo `postgres` superusuario con BYPASSRLS.
# Estos dos se crean a mano en la migración inicial. Ver ADR 0001 §2.
DATABASE_URL="postgresql://xula_app:cambiar@localhost:5432/xula"
MIGRATION_DATABASE_URL="postgresql://xula_migrator:cambiar@localhost:5432/xula"

# openssl rand -base64 48
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Cloudflare R2: bucket de un solo proposito para assets de marca.
R2_ENDPOINT=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="xula-assets"
R2_PUBLIC_URL=""

# UTC fijo. La fecha civil se deriva en America/Merida. Ver ADR 0001 §6.
TZ="UTC"

DOMINIO_BASE="xulasigma.mx"

SUPER_ADMIN_DATABASE_URL="postgresql://xula_super_admin:cambiar@localhost:5432/xula"

#   openssl rand -hex 32
PIMIENTA_INTENTOS=""