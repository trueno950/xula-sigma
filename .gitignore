# Dependencias
node_modules/
.pnpm-store/

# Build
.next/
out/
build/
dist/
*.tsbuildinfo

# Entorno — .env.example SI se commitea, .env NUNCA
# Ver docs/05-seguridad.md seccion 8
.env
.env.*
!.env.example

# Tests
coverage/
test-results/
playwright-report/
.playwright/
# Capturas y sesiones efimeras de `agent-browser`: no se versionan y, sin
# esta linea, quedan como archivos sin seguimiento que la evaluacion nativa
# de RDD no puede declarar.
.playwright-cli/

# Herramientas
.husky/_/
.turbo/
.vercel/

# Indice de skills, regenerable
.atl/

# Indice de CodeGraph, local a cada maquina. Mismo defecto que el lock de
# abajo si entra al indice a mitad de un commit: "invalid object ... Error
# building trees" (visto en esta sesion contra .codegraph/.gitignore).
.codegraph/

# Lock de tareas programadas del agente. Aparece y desaparece durante un
# commit, y si entra al indice lo rompe: "invalid object ... Error building
# trees". El resto de .claude/ SI se commitea.
.claude/scheduled_tasks.lock

# Editor
.vscode/
.idea/

# macOS
.DS_Store

# Ajustes personales de Claude Code, no del repositorio: el sufijo `local`
# es justamente esa convencion. `settings.json` SI se commitea.
.claude/settings.local.json

# Estado de maquina del agente por defecto de gentle-ai ("state":
# "managed"). Mismo criterio que `.codegraph/`: describe esta copia, no el
# proyecto.
.gentle-ai-default-agent.json

# Preflight local de gentle-ai SDD. Mismo criterio que `.codegraph/`:
# describe esta copia, no el proyecto.
.pi/

# Configuracion de las herramientas de agentes: vive en cada maquina, no en
# el repositorio. Lo que se acepta con eso: dos maquinas pueden tener permisos
# y MCP distintos, y ese cambio no pasa por un PR.
opencode.json
.opencode/
